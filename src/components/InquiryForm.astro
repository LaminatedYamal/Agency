---
interface Props {
  defaultService?: string;
  subpageSubject?: string;
}

const { defaultService = 'astro', subpageSubject = '[BRUTO DOSSIER] Nova Submissão' } = Astro.props;
---

<section id="contact" class="section-contact">
  <div class="content-container">
    <div class="contact-card">
      <div class="contact-info">
        <span class="section-num" data-i18n="sec5_num">05 // START PROJECT</span>
        <h2 class="contact-headline" data-i18n="sec5_title">Let us solve your problem definitively.</h2>
        <p class="contact-sub" data-i18n="sec5_subtitle">
          Tell us what is broken, slow, or manual in your business. We will analyze your case and propose a tailored, no-fluff solution.
        </p>

        <div class="contact-details">
          <div class="detail-item">
            <span class="detail-label" data-i18n="contact_loc_label">LOCATION</span>
            <span class="detail-val" data-i18n="contact_loc_val">Lisbon / Porto, Portugal</span>
          </div>
          <div class="detail-item">
            <span class="detail-label" data-i18n="contact_time_label">LOCAL TIME</span>
            <span id="footer-time" class="detail-val">16:49 PORTUGAL (GMT+0)</span>
          </div>
          <div class="detail-item">
            <span class="detail-label" data-i18n="contact_email_label">DIRECT INQUIRIES</span>
            <a href="mailto:bruto.agenciamarketing@gmail.com" class="detail-val" style="color:inherit; text-decoration:none;" data-i18n="contact_email_val">bruto.agenciamarketing@gmail.com</a>
          </div>
        </div>
      </div>

      <form class="contact-form" id="inquiry-form" action="https://formsubmit.co/bruto.agenciamarketing@gmail.com" method="POST">
        <!-- FormSubmit Anti-Spam & Routing -->
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_subject" value={subpageSubject} />
        <input type="hidden" name="_template" value="table" />
        <input type="text" name="_honey" style="display:none" />

        <div class="form-group">
          <label for="name-input" data-i18n="form_name_label">FULL NAME OR ORGANIZATION</label>
          <input type="text" id="name-input" name="name" required placeholder="e.g. David Daniel / Vanguard Ltd" data-i18n-ph="form_name_ph" />
        </div>

        <div class="form-group">
          <label for="email-input" data-i18n="form_contact_label">EMAIL OR WHATSAPP NUMBER</label>
          <input type="text" id="email-input" name="contact" required placeholder="contact@domain.com or +351 912 345 678" data-i18n-ph="form_contact_ph" />
        </div>

        <div class="form-group">
          <label for="scope-input" data-i18n="form_service_label">SERVICE NEEDED</label>
          <select id="scope-input" name="service">
            <option value="astro" selected={defaultService === 'astro'} data-i18n="form_opt_astro">Custom Made Astro Website (Ultra-Fast / Cloudflare Pages)</option>
            <option value="wordpress" selected={defaultService === 'wordpress'} data-i18n="form_opt_web">Custom Website or Online Store (WordPress / Shopify)</option>
            <option value="shopify" selected={defaultService === 'shopify'} data-i18n="shopify_hero_title">Shopify Plus & Stores</option>
            <option value="automation" selected={defaultService === 'automation'} data-i18n="form_opt_auto">Workflow Automations (n8n / Integrations)</option>
            <option value="growth" selected={defaultService === 'growth'} data-i18n="form_opt_growth">Search &amp; Paid Acquisition (Google, Meta, LinkedIn, TikTok &amp; Reddit)</option>
            <option value="social" selected={defaultService === 'social'} data-i18n="form_opt_social">Brand Presence &amp; Social Media</option>
            <option value="full-system" selected={defaultService === 'full-system'} data-i18n="form_opt_full">Full Digital Overhaul (Web + Automations + Growth)</option>
            <option value="other" selected={defaultService === 'other'} data-i18n="form_opt_other">Other / Unsure (Let us discuss the problem)</option>
          </select>
        </div>

        <div class="form-group">
          <label for="message-input" data-i18n="form_msg_label">THE PROBLEM TO SOLVE</label>
          <textarea id="message-input" name="message" rows="3" placeholder="Describe your current situation, what is causing friction, or what you want to achieve..." data-i18n-ph="form_msg_ph"></textarea>
        </div>

        <button type="submit" class="submit-btn">
          <span data-i18n="form_submit">INITIATE TRANSMISSION →</span>
        </button>
        <div id="form-feedback" class="form-feedback"></div>
      </form>
    </div>
  </div>
</section>
