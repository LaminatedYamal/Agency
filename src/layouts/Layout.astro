---
interface Props {
  title?: string;
  description?: string;
  lang?: string;
  isSubpage?: boolean;
}

const {
  title = "BRUTO — Heavy-Duty Digital // Websites, Automations & Acquisition",
  description = "Not an agency. Not a studio. Heavy-duty digital engineering for founders demanding permanent authority.",
  lang = "en",
  isSubpage = false
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Primary Font: Avenor (Self-Hosted WOFF2) -->
  <link rel="preload" href="/fonts/avenor/at-avenor.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Premium Typography: Syne, Space Mono, Playfair Display -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,900;1,600&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Syne:wght@600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Favicon System -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <!-- Global Brutalist CSS Framework -->
  <link rel="stylesheet" href="/src/style.css" />
</head>
<body class={`bg-studio ${isSubpage ? 'subpage-body' : ''}`}>
  <slot />

  <!-- Core Client Island Script -->
  <script type="module" src="/src/main.js"></script>
</body>
</html>
